  "components": {
    "schemas": {
      "ListingInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 0
          },
          "type": {
            "type": "string",
            "pattern": "APARTMENT|VILLA|CABIN|SUITE|HOTEL_ROOM"
          },
          "destination": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "latitude": {
            "type": "number",
            "maximum": 90,
            "minimum": -90
          },
          "longitude": {
            "type": "number",
            "maximum": 180,
            "minimum": -180
          },
          "capacity": {
            "type": "integer",
            "format": "int32",
            "maximum": 16,
            "minimum": 1
          },
          "beds": {
            "type": "integer",
            "format": "int32",
            "maximum": 16,
            "minimum": 1
          },
          "bathrooms": {
            "type": "integer",
            "format": "int32",
            "maximum": 12,
            "minimum": 1
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "Wi-Fi|Parking|Pool|Kitchen|Ocean view|Air conditioning|Workspace|Fireplace|Garden|Breakfast"
            },
            "maxItems": 12,
            "minItems": 0
          },
          "nightlyRate": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 100.0
          },
          "cleaningFee": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 0.0
          },
          "houseRules": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 0
          },
          "cancellationPolicy": {
            "type": "string",
            "pattern": "FLEXIBLE|MODERATE"
          },
          "submit": {
            "type": "boolean"
          }
        },
        "required": [
          "amenities",
          "cancellationPolicy",
          "cleaningFee",
          "description",
          "destination",
          "houseRules",
          "latitude",
          "longitude",
          "nightlyRate",
          "title",
          "type"
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "format": "uuid"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "guests": {
            "type": "integer",
            "format": "int32",
            "maximum": 16,
            "minimum": 1
          }
        },
        "required": [
          "checkIn",
          "checkOut",
          "listingId"
        ]
      },
      "Block": {
        "type": "object",
        "properties": {
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "checkIn",
          "checkOut"
        ]
      },
      "Entry": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "pattern": "GUEST|HOST|ADMIN"
          }
        },
        "required": [
          "role"
        ]
      },
      "HoldRequest": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "quoteId"
        ]
      },
      "ReviewInput": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "integer",
            "format": "int32",
            "maximum": 5,
            "minimum": 1
          },
          "body": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 0
          }
        },
        "required": [
          "body"
        ]
      },
      "ConfirmRequest": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string"
          },
          "policyAccepted": {
            "type": "boolean"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "Register": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "name",
          "password"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Publication": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "CsrfToken": {
        "type": "object",
        "properties": {
          "headerName": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "parameterName": {
            "type": "string"
          }
        }
      },
      "ImageRemoval": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 500,
            "minLength": 0
          }
        },
        "required": [
          "url"
        ]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "name": "SESSION",
        "in": "cookie"
      },
      "csrf": {
        "type": "apiKey",
        "name": "X-CSRF-TOKEN",
        "in": "header"
      }
    }
  }
}
