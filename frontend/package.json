{
  "name": "sundrift-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "@next/eslint-plugin-next": "16.4.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "@axe-core/playwright": "4.14.0"
  }
}
